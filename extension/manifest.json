{
  "manifestVersion": 5,
  "id": "com.custom.ytpremiereimporter",
  "name": "YT Premiere Importer",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "YT Video Importer"
      },
      "minimumSize": {
        "width": 260,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 450
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}